<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 8 support ends Nov 2026; change to net8.0-windows if that's the SDK you have. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DayTask</AssemblyName>
    <RootNamespace>DayTask.Desktop</RootNamespace>
    <!-- Desktop shell version, shown in the tray menu and Settings > About. Bump it with each
         change to the shell. The build adds the git commit it was built from. -->
    <Version>1.2.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Same artwork as the web app (icon.svg); icon.ico is rendered from it. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- The WebView2 package references its WPF assembly even in a WinForms-only app;
         it was built against WindowsBase 5.0.0.0 and net10.0 ships 4.0.0.0. Harmless. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <None Update="desktop.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- ApplicationIcon covers the exe and taskbar; the window and tray read this copy so they
         can pick the frame that matches the size they need. -->
    <EmbeddedResource Include="icon.ico" LogicalName="DayTask.Desktop.icon.ico" />
  </ItemGroup>

</Project>
